<view class="page-shell">
  <view class="hero">
    <view class="hero-decoration"></view>
    <view class="brand-row">
      <view class="brand-mark" aria-label="SCY百宝箱">
        <view class="brand-cell brand-cell-primary"></view>
        <view class="brand-cell brand-cell-warm"></view>
        <view class="brand-cell brand-cell-accent"></view>
        <view class="brand-cell brand-cell-secondary"></view>
      </view>
      <view class="brand-copy">
        <view class="brand-name">SCY百宝箱</view>
        <view class="brand-subtitle">实用工具，一触即达</view>
      </view>
    </view>

    <view class="search-box">
      <view class="search-icon"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索工具..."
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">x</view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false">
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-item {{currentCategory === item.id ? 'category-item-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <view class="content-section">
    <view class="section-heading">
      <view class="section-title">常用工具</view>
      <view class="result-count">{{filteredTools.length}} 个工具</view>
    </view>

    <view wx:if="{{filteredTools.length}}" class="tool-grid">
      <view
        wx:for="{{filteredTools}}"
        wx:key="id"
        class="tool-item"
        data-name="{{item.name}}"
        bindtap="onToolTap"
      >
        <view class="tool-icon icon-{{item.icon}}">
          <text>{{item.symbol}}</text>
        </view>
        <view class="tool-name">{{item.name}}</view>
      </view>
    </view>

    <view wx:else class="empty-state">
      <image class="empty-image" src="/images/icons/notData.svg" mode="aspectFit"></image>
      <view class="empty-title">暂无数据</view>
      <view class="empty-desc">更多工具正在整理中</view>
    </view>
  </view>
</view>
