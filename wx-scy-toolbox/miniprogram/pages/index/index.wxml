<view class="page-shell">
  <view class="hero">
    <view class="hero-decoration"></view>
    <view class="brand-row">
      <view class="brand-mark" aria-label="SCY百宝箱">
        <view class="brand-cell brand-cell-primary"></view>
        <view class="brand-cell brand-cell-warm"></view>
        <view class="brand-cell brand-cell-accent"></view>
        <view class="brand-cell brand-cell-secondary"></view>
      </view>
      <view class="brand-copy">
        <view class="brand-name">SCY百宝箱</view>
        <view class="brand-subtitle">实用工具，一触即达</view>
      </view>
    </view>

    <view class="search-box">
      <view class="search-icon"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索工具..."
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">x</view>
    </view>
  </view>

  <scroll-view class="category-scroll" scroll-x="true" show-scrollbar="false">
    <view class="category-list">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="category-item {{currentCategory === item.id ? 'category-item-active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <view class="content-section">
    <view class="section-heading">
      <view class="section-title">常用工具</view>
      <view class="result-count">{{filteredTools.length}} 个工具</view>
    </view>

    <view wx:if="{{filteredTools.length}}" class="tool-grid">
      <view
        wx:for="{{filteredTools}}"
        wx:key="id"
        class="tool-item"
        data-name="{{item.name}}"
        bindtap="onToolTap"
      >
        <view class="tool-icon icon-{{item.icon}}">
          <text>{{item.symbol}}</text>
        </view>
        <view class="tool-name">{{item.name}}</view>
      </view>
    </view>

    <view wx:else class="empty-state">
      <image class="empty-image" src="/images/icons/notData.svg" mode="aspectFit"></image>
      <view class="empty-title">暂无数据</view>
      <view class="empty-desc">更多工具正在整理中</view>
    </view>
  </view>

  <view wx:if="{{showConsentModal}}" class="consent-mask" catchtouchmove="noop">
    <view class="consent-dialog">
      <view class="consent-dialog-title">使用前请确认</view>
      <view class="consent-dialog-subtitle">照片修复仅处理您有权处理的图片</view>
      <view class="consent-rule">
        <view class="consent-rule-index consent-rule-pink">1</view>
        <view>您承诺拥有所选图片的版权或已获得合法处理授权。</view>
      </view>
      <view class="consent-rule">
        <view class="consent-rule-index consent-rule-yellow">2</view>
        <view>仅支持手动标记局部区域，不提供批量处理或自动识别版权水印。</view>
      </view>
      <view class="consent-rule">
        <view class="consent-rule-index consent-rule-blue">3</view>
        <view>图片仅在本机处理，不会上传原图。</view>
      </view>
      <checkbox-group class="consent-checkbox" bindchange="onConsentCheckChange">
        <label class="consent-label">
          <checkbox value="image-rights" color="#F19AAC" checked="{{consentAccepted}}" />
          <text>我已阅读并承诺拥有图片处理权</text>
        </label>
      </checkbox-group>
      <button class="consent-confirm" loading="{{consentSubmitting}}" disabled="{{consentSubmitting}}" bindtap="onConsentAccept">同意并继续</button>
      <button class="consent-reject" disabled="{{consentSubmitting}}" bindtap="onConsentReject">拒绝并退出</button>
    </view>
  </view>
</view>
