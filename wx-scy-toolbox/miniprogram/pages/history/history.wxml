<view class="page"><button wx:if="{{history.length}}" class="clear" bindtap="onClear">清除使用历史</button><view wx:if="{{loading}}" class="empty">正在加载</view><view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button class="retry" bindtap="onRetry">重新加载</button></view><block wx:elif="{{history.length}}"><view wx:for="{{history}}" wx:key="id" class="row" data-tool="{{item.tool}}" bindtap="onOpen"><view>{{item.tool.name}}</view><text wx:if="{{!item.tool.available}}">已下线</text><text>{{item.usedAt}}</text></view></block><view wx:else class="empty">{{emptyText}}</view></view>
