<view class="page"><view wx:if="{{loading}}" class="empty">正在加载</view><view wx:elif="{{error}}" class="empty"><view>{{error}}</view><button class="retry" bindtap="onRetry">重新加载</button></view><block wx:elif="{{tools.length}}"><view wx:for="{{tools}}" wx:key="toolId" class="row"><view class="copy" data-tool="{{item}}" bindtap="onOpen"><view>{{item.name}}</view><text wx:if="{{!item.available}}">已下线</text></view><button class="remove" data-tool-id="{{item.toolId}}" bindtap="onRemove">取消收藏</button></view></block><view wx:else class="empty">{{emptyText}}</view></view>
